{
  "name": "earth-online",
  "version": "0.1.0",
  "private": true,
  "description": "地球Online · 初始框架：共享契约 + three.js 世界层 + 参考应用（书架 / 书 / 天 / 日记）",
  "type": "module",
  "scripts": {
    "dev": "vite web --host",
    "build": "vite build web",
    "preview": "vite preview web --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test \"shared/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run check:shared && npm run build",
    "export:shared": "node --experimental-strip-types tools/export-shared.ts",
    "sync:shells": "node --experimental-strip-types tools/export-shared.ts --world",
    "check:shared": "node --experimental-strip-types tools/export-shared.ts --check"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
