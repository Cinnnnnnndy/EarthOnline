{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://earth-online.app/spec/trip.schema.json",
  "title": "Trip",
  "description": "地球Online 旅程（一本书）。schemaVersion 0.2。两端导入导出、云同步都以此为准。",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "destination", "startDate", "endDate", "theme", "seed", "status", "days", "createdAt", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "0.3" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 40 },
    "destination": { "type": "string", "minLength": 1 },
    "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "endDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "theme": { "type": "string" },
    "seed": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["planning", "traveling", "closed"] },
    "plan": { "type": "object", "required": ["group", "index", "label"], "properties": { "group": { "type": "string" }, "index": { "type": "integer" }, "label": { "type": "string" } } },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "days": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/definitions/Day" } },
    "suitcase": { "type": "object", "description": "行李箱的增减（可选）：藏起来的东西、从库里挑的特色物件、自己从清单里挑的随身物件、自己放进去的照片卡（图存在设备上，这里只记尺寸）", "additionalProperties": false, "properties": {
      "hidden": { "type": "array", "items": { "type": "string" } },
      "picks": { "type": "array", "items": { "type": "string" } },
      "gear": { "type": "array", "items": { "type": "string" } },
      "cards": { "type": "array", "maxItems": 6, "items": { "type": "object", "required": ["id", "kind", "w", "h"], "additionalProperties": false, "properties": {
        "id": { "type": "string" }, "kind": { "enum": ["cutout", "polaroid"] }, "w": { "type": "integer", "minimum": 1 }, "h": { "type": "integer", "minimum": 1 }, "label": { "type": "string", "maxLength": 40 } } } } } }
  },
  "definitions": {
    "Day": {
      "type": "object",
      "required": ["index", "date", "title", "city", "entries"],
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "title": { "type": "string" },
        "city": { "enum": ["osaka", "kyoto", "nara", "kobe", "geo"] },
        "lodging": { "type": "string" },
        "diary": { "type": "string" },
        "color": { "type": "string" },
        "entries": { "type": "array", "items": { "$ref": "#/definitions/Entry" } }
      }
    },
    "Entry": {
      "oneOf": [
        { "$ref": "#/definitions/PlaceEntry" },
        { "$ref": "#/definitions/TransportEntry" },
        { "$ref": "#/definitions/LodgingEntry" }
      ]
    },
    "PlaceEntry": {
      "type": "object",
      "required": ["id", "type", "name", "category"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "place" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "enum": ["sight", "food", "shop", "station", "airport", "port", "hotel", "other"] },
        "plannedStart": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "stayMinutes": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string" },
        "visited": { "type": "boolean" },
        "visitedAt": { "type": "string" },
        "geo": { "type": "object", "required": ["lat", "lng"], "properties": { "lat": { "type": "number" }, "lng": { "type": "number" } } },
        "kind": { "type": "string", "description": "景点类型（可选），取值见 shared/world/landmark-kinds.ts 的 KINDS" },
        "todos": { "type": "array", "description": "待办（可选）：规划时记下要提前做的事", "items": { "type": "object", "required": ["id", "text"], "additionalProperties": false, "properties": {
          "id": { "type": "string" }, "text": { "type": "string", "minLength": 1 }, "due": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "done": { "type": "boolean" } } } }
      }
    },
    "TransportEntry": {
      "type": "object",
      "required": ["id", "type", "mode", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "transport" },
        "mode": { "enum": ["walk", "rail", "subway", "bus", "ship", "taxi", "car", "flight"] },
        "label": { "type": "string" },
        "durationMinutes": { "type": "integer", "minimum": 0 },
        "distanceKm": { "type": "number", "minimum": 0 },
        "polyline": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } }
      }
    },
    "LodgingEntry": {
      "type": "object",
      "required": ["id", "type", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "lodging" },
        "name": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
