        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声と計画"
          }
        }
      }
    },
    "语音识别和离线规划都在手机上完成。云端规划是 Pro 功能。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition and offline planning happen on this iPhone. Cloud planning is a Pro feature."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声認識とオフライン計画は端末上で行う。クラウド計画は Pro 機能。"
          }
        }
      }
    },
    "语音识别在手机上完成；只把对话文字发给你填的规划服务。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech is recognized on this iPhone; only the conversation text goes to the service you entered."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声は端末上で認識し、会話の文字だけを入力したサービスに送る。"
          }
        }
      }
    },
    "说一说": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say it"
