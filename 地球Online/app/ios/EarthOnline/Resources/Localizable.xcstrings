    },
    "说一说或选一个目的地，生成一本新的旅程": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say it or pick a destination to start a new trip"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話すか目的地を選んで、新しい旅行を作る"
          }
        }
      }
    },
    "说话": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話す"
          }
        }
      }
    },
    "说说想去哪里、玩几天、什么时候出发。比如：「十月去京都玩五天，看红叶」。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell me where you'd like to go, for how long and when. For example: “Five days in Kyoto in October for the autumn leaves.”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行きたい場所、日数、出発日を話してね。たとえば「10月に京都で5日間、紅葉を見たい」。"
          }
        }
      }
    },
    "请先在系统设置里登录 iCloud": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud in Settings first"
